; Godot 4.x project
config_version=5

[application]
config/name="증강 지뢰찾기"
boot_splash/image="res://logo.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color(0.055, 0.07, 0.11, 1)
run/main_scene="res://main.tscn"
run/max_fps=30
run/low_processor_mode=true

[display]
window/size/viewport_width=1200
window/size/viewport_height=850
window/size/window_width_override=1200
window/size/window_height_override=850
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
